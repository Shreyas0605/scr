#include <winres.h>
#include "resource.h"

// ---------------------------------------------------------------------
// Icon
// ---------------------------------------------------------------------
IDI_APPICON ICON "../assets/icons/app.ico"

// ---------------------------------------------------------------------
// Manifest
//
// Resource ID 1 with type RT_MANIFEST (24) is CREATEPROCESS_MANIFEST_
// RESOURCE_ID: the manifest Windows applies to the process at launch,
// independent of any manifest the linker would otherwise auto-generate.
// GenerateManifest is turned off in the .vcxproj so this is the only one
// embedded, avoiding a resource-ID collision.
// ---------------------------------------------------------------------
1 24 "FlipClock.manifest"

// ---------------------------------------------------------------------
// Version info
// ---------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "FlipClock Screensaver Project"
            VALUE "FileDescription",  "FlipClock Screensaver"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "FlipClock"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "FlipClock.scr"
            VALUE "ProductName",      "FlipClock Screensaver"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
